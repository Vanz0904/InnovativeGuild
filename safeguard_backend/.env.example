# Server
PORT=4000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=safeguard

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default admin (used by database/seed.js — change immediately after first login)
DEFAULT_ADMIN_EMAIL=admin@safeguard.mw
DEFAULT_ADMIN_PASSWORD=SafeGuard@2026
DEFAULT_ADMIN_NAME=SafeGuard Administrator

# Flutterwave (get these from https://dashboard.flutterwave.com/settings/apis)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_HASH=change_this_webhook_hash_and_set_same_value_in_flutterwave_dashboard
FLW_BASE_URL=https://api.flutterwave.com/v3

# Escrow fee
ESCROW_FEE_RATE=0.02
